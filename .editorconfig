root = true

# shfmt reads these settings.
[*.sh]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true

[githooks/*]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true

# Shared shell config is sourced by both bash and zsh, so keep it POSIX.
[shell/*.sh]
shell_variant = posix
